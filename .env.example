# ==============================================================================
# XAMPP / Local MySQL Database Configuration
# Default XAMPP settings: Host is localhost (or 127.0.0.1), Port is 3306,
# User is root, Password is empty (blank).
# Database Name: uicms_workflow
# phpMyAdmin URL: http://localhost/phpmyadmin/index.php?route=/database/structure&db=uicms_workflow
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uicms_workflow
DB_USER=root
DB_PASS=

# ==============================================================================
# Application & Gemini AI Secrets
# ==============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ==============================================================================
# Amazon Simple Email Service (SES) Configuration
# Region: af-south-1 (Cape Town)
# ==============================================================================
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@uwiniwin.co.za
SES_FROM_NAME=UICMS
